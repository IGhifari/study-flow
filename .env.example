# ==============================================================================
# StudyFlow — Root Environment Template
# ==============================================================================
# Salin file ini atau file .env.example spesifik per workspace:
#   - Database/Prisma : packages/database/.env.example  -> packages/database/.env
#   - Backend API     : apps/api/.env.example            -> apps/api/.env
#   - Background Worker: apps/worker/.env.example        -> apps/worker/.env
#   - Frontend Web    : apps/web/.env.example           -> apps/web/.env.local
#
# Untuk kemudahan local development monorepo, file .env di root ini juga dapat
# digunakan sebagai acuan variabel umum.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & DOCKER COMPOSE (PostgreSQL)
# Digunakan oleh: docker-compose.yml, Prisma CLI, apps/api, apps/worker
# ------------------------------------------------------------------------------
POSTGRES_USER=studyflow_user
POSTGRES_PASSWORD=studyflow_dev_password
POSTGRES_DB=studyflow_dev
POSTGRES_PORT=5433
DATABASE_URL="postgresql://studyflow_user:studyflow_dev_password@localhost:5433/studyflow_dev?schema=public"

# ------------------------------------------------------------------------------
# 2. REDIS & QUEUE (BullMQ)
# Digunakan oleh: docker-compose.yml, apps/api (readiness), apps/worker
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 3. BACKEND API (Express)
# Digunakan oleh: apps/api
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Autentikasi JWT & Sesi (Gunakan string acak minimal 32 karakter pada produksi)
JWT_ACCESS_SECRET="studyflow_dev_jwt_access_secret_super_secure_key_12345"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Database & Redis pengujian terisolasi (Vitest & Playwright E2E)
# Wajib diarahkan ke target pengujian terpisah (*_test dan Redis DB index 15) untuk mencegah modifikasi data development.
DATABASE_URL_TEST="postgresql://studyflow_user:studyflow_dev_password@localhost:5433/studyflow_test?schema=public"
REDIS_URL_TEST="redis://localhost:6379/15"

# Proxy & Rate Limiting Express API
TRUST_PROXY="loopback"
RATE_LIMIT_STORE="redis"

# ------------------------------------------------------------------------------
# 4. FRONTEND WEB (Next.js App Router)
# Digunakan oleh: apps/web
# CATATAN: Variabel berawalan NEXT_PUBLIC_ dapat dibaca oleh browser.
# JANGAN meletakkan secret backend atau password database dengan prefix ini!
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
INTERNAL_API_URL="http://localhost:4000"

# Ingress Header untuk identifikasi IP klien di BFF:
# Kosongkan ("" / default) untuk mode aman tanpa trusted reverse proxy (semua request -> 127.0.0.1).
# Isi (mis. 'x-real-ip' | 'cf-connecting-ip') HANYA bila ingress terpercaya menimpa header tersebut.
TRUSTED_CLIENT_IP_HEADER=""

# ------------------------------------------------------------------------------
# 5. STORAGE (Supabase Storage atau Local Filesystem)
# Digunakan oleh: apps/api, apps/worker
# Driver opsi: 'local' (disk storage dev bersama worker), 'supabase' (remote bucket), 'memory' (mock test), 'none' (disabled)
# CATATAN: Kredensial service role bersifat privileged dan rahasia.
# JANGAN gunakan prefix NEXT_PUBLIC_ atau commit kredensial asli ke git!
# Bucket HARUS privat: 'studyflow-materials'
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"
SUPABASE_STORAGE_BUCKET="studyflow-materials"
STORAGE_SIGNED_URL_EXPIRES_IN=300
LOCAL_STORAGE_DIR=".storage/materials"

# ------------------------------------------------------------------------------
# 6. AI PROVIDER (Milestone 6 — Ringkasan Materi dengan Gemini Free Tier)
# Digunakan oleh: apps/api, apps/worker
# Provider opsi:
#   - 'gemini' : Google AI Studio Gemini API free tier (tanpa billing).
#   - 'mock'   : Deterministic mock adapter untuk automated testing.
#   - 'none'   : Disabled (menampilkan fitur tidak tersedia secara anggun).
# CATATAN PENTING KEAMANAN & BIAYA:
#   - Pengguna WAJIB memastikan project di Google AI Studio berada pada Free Tier.
#   - JANGAN mengaktifkan billing / pay-as-you-go di Google Cloud Console.
#   - JANGAN menggunakan prefix NEXT_PUBLIC_ untuk GEMINI_API_KEY.
#   - Kredensial hanya dibaca oleh backend dan worker (server-side only).
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY="your-google-ai-studio-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash-lite"

# ------------------------------------------------------------------------------
# 7. GOOGLE OAUTH 2.0 (Authorization Code Flow with PKCE & Nonce)
# Digunakan oleh: apps/api
# Callback terdaftar di Google Cloud Console:
#   http://localhost:3000/api/auth/google/callback
# Kredensial rahasia server-side: JANGAN mengekspos client secret ke browser!
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ------------------------------------------------------------------------------
# 8. EMAIL & SMTP SERVICE (Lupa Password / Password Reset)
# Digunakan oleh: apps/api
# Driver opsi:
#   - 'smtp' : Mengirim email sungguhan via server SMTP (mis. Mailtrap, Gmail, Brevo, AWS SES).
#   - 'mock' : Pengujian lokal & CI tanpa kirim email sungguhan (antrean test in-memory).
# APP_PUBLIC_URL digunakan untuk membangun tautan reset password yang valid.
# ------------------------------------------------------------------------------
APP_PUBLIC_URL="http://localhost:3000"
EMAIL_DRIVER=mock
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_FROM="StudyFlow <no-reply@studyflow.app>"


