// Prisma schema for StudyFlow
// Milestone 2 - Authentication: User and RefreshSession models

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  passwordHash    String?          @map("password_hash")
  timezone        String           @default("Asia/Jakarta")
  role            Role             @default(USER)
  emailVerifiedAt DateTime?        @map("email_verified_at")
  reminderEmailDeadline Boolean      @default(false) @map("reminder_email_deadline")
  tokenVersion    Int              @default(0) @map("token_version")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  federatedIdentities FederatedIdentity[]
  refreshSessions RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  assignmentReminderLogs  AssignmentReminderLog[]
  pinnedItems     PinnedItem[]
  semesters       Semester[]
  courses         Course[]
  assignments     Assignment[]
  notes           Note[]
  materials       Material[]
  processingJobs  ProcessingJob[]
  storageUsage    StorageUsage?
  dailyCounters   DailyUploadCounter[]
  summaries       MaterialSummary[]
  aiUsage         AiUsage?
  flashcardSets   FlashcardSet[]
  quizzes         Quiz[]
  quizAttempts    QuizAttempt[]
  schedules       CourseSchedule[]

  @@map("users")
}

model FederatedIdentity {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  subject   String
  email     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, subject])
  @@index([userId])
  @@map("federated_identities")
}

// Milestone 3 — Semester & Course
// Invariants enforced in migration SQL (not expressible in Prisma schema):
//   - semesters_one_active_per_user: partial UNIQUE (user_id) WHERE is_active
//   - semesters_active_not_archived: CHECK (NOT (is_active AND archived_at IS NOT NULL))
model Semester {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  academicYear String    @map("academic_year")
  isActive     Boolean   @default(false) @map("is_active")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  courses Course[]

  // Target for the composite FK from Course, guaranteeing course.userId == semester.userId
  @@unique([id, userId])
  @@index([userId, createdAt])
  @@map("semesters")
}

model Course {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesterId  String    @map("semester_id")
  semester    Semester  @relation(fields: [semesterId, userId], references: [id, userId], onDelete: NoAction)
  name        String
  code        String?
  lecturer    String?
  description String?
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  assignments Assignment[]
  notes       Note[]
  materials   Material[]
  schedules   CourseSchedule[]

  // Target for composite FK from Assignment, Note & Material
  @@unique([id, userId])
  @@index([userId, semesterId])
  @@index([userId, name])
  @@map("courses")
}

// Milestone 4 — Assignments & Notes
enum AssignmentPriority {
  LOW
  MEDIUM
  HIGH
}

enum AssignmentStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Assignment {
  id          String             @id @default(cuid())
  userId      String             @map("user_id")
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String             @map("course_id")
  course      Course             @relation(fields: [courseId, userId], references: [id, userId], onDelete: Restrict)
  title       String
  description String?
  dueDate     DateTime           @map("due_date")
  priority    AssignmentPriority @default(MEDIUM)
  status      AssignmentStatus   @default(TODO)
  completedAt      DateTime?          @map("completed_at")
  firstCompletedAt DateTime?          @map("first_completed_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  reminderLogs AssignmentReminderLog[]
  subtasks     AssignmentSubtask[]

  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([userId, firstCompletedAt])
  @@index([courseId])
  @@index([status, dueDate])
  @@map("assignments")
}

model AssignmentSubtask {
  id           String     @id @default(cuid())
  assignmentId String     @map("assignment_id")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  title        String
  isCompleted  Boolean    @default(false) @map("is_completed")
  order        Int        @default(0)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([assignmentId, order])
  @@map("assignment_subtasks")
}

model Note {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String    @map("course_id")
  course     Course    @relation(fields: [courseId, userId], references: [id, userId], onDelete: Restrict)
  materialId String?   @map("material_id")
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  title      String
  content    String    @default("")
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  pinnedItems PinnedItem[]

  @@index([userId, updatedAt])
  @@index([courseId])
  @@index([materialId])
  @@map("notes")
}

// Milestone 5 — Material, ProcessingJob, Outbox, and Quota models
enum MaterialStatus {
  UPLOADING
  QUEUED
  PROCESSING
  READY
  FAILED
}

model Material {
  id               String         @id @default(cuid())
  userId           String         @map("user_id")
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String         @map("course_id")
  course           Course         @relation(fields: [courseId, userId], references: [id, userId], onDelete: Restrict)
  title            String
  originalFilename String         @map("original_filename")
  storageKey       String         @unique @map("storage_key")
  mimeType         String         @default("application/pdf") @map("mime_type")
  bytes            Int
  pageCount        Int?           @map("page_count")
  status           MaterialStatus @default(UPLOADING)
  errorCode        String?        @map("error_code")
  errorMessage     String?        @map("error_message")
  deletedAt        DateTime?      @map("deleted_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  pages          MaterialPage[]
  notes          Note[]
  processingJobs ProcessingJob[]
  summary        MaterialSummary?
  flashcardSets  FlashcardSet[]
  quizzes        Quiz[]
  pinnedItems    PinnedItem[]

  // Target for composite FK references if needed
  @@unique([id, userId])
  @@index([userId, courseId])
  @@index([userId, status])
  @@index([courseId])
  @@map("materials")
}

model MaterialPage {
  id             String   @id @default(cuid())
  materialId     String   @map("material_id")
  material       Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  pageNumber     Int      @map("page_number")
  extractedText  String   @map("extracted_text")
  characterCount Int      @default(0) @map("character_count")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([materialId, pageNumber])
  @@index([materialId])
  @@map("material_pages")
}

enum ProcessingJobType {
  DOCUMENT_EXTRACTION
  DOCUMENT_CLEANUP
  AI_SUMMARY_GENERATION
  AI_FLASHCARD_GENERATION
  AI_QUIZ_GENERATION
}

enum ProcessingJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ProcessingJob {
  id             String              @id @default(cuid())
  userId         String              @map("user_id")
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId     String?             @map("material_id")
  material       Material?           @relation(fields: [materialId], references: [id], onDelete: SetNull)
  type           ProcessingJobType   @default(DOCUMENT_EXTRACTION)
  status         ProcessingJobStatus @default(PENDING)
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3) @map("max_attempts")
  idempotencyKey String?             @unique @map("idempotency_key")
  errorMessage   String?             @map("error_message")
  errorCode      String?             @map("error_code")
  payload        Json?
  startedAt      DateTime?           @map("started_at")
  completedAt    DateTime?           @map("completed_at")
  failedAt       DateTime?           @map("failed_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([materialId])
  @@map("processing_jobs")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id          String       @id @default(cuid())
  eventType   String       @map("event_type")
  aggregateId String       @map("aggregate_id")
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?      @map("last_error")
  publishedAt DateTime?    @map("published_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

model StorageUsage {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedBytes     BigInt   @default(0) @map("used_bytes")
  reservedBytes BigInt   @default(0) @map("reserved_bytes")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("storage_usages")
}

model DailyUploadCounter {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadDate  String   @map("upload_date") // YYYY-MM-DD in UTC
  uploadCount Int      @default(0) @map("upload_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, uploadDate])
  @@index([userId, uploadDate])
  @@map("daily_upload_counters")
}

model RefreshSession {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash")
  familyId    String    @map("family_id")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, expiresAt])
  @@index([email])
  @@map("email_verification_tokens")
}

// Milestone 6 — AI Summaries
enum SummaryStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

model MaterialSummary {
  id                   String        @id @default(cuid())
  userId               String        @map("user_id")
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId           String        @unique @map("material_id")
  material             Material      @relation(fields: [materialId], references: [id], onDelete: Cascade)
  status               SummaryStatus @default(QUEUED)
  title                String?
  overview             String?       @db.Text
  keyConcepts          Json?         @map("key_concepts")
  sections             Json?
  keyTerms             Json?         @map("key_terms")
  limitations          String?       @db.Text
  provider             String        @default("gemini")
  model                String        @default("gemini-2.5-flash")
  promptVersion        String        @default("v1") @map("prompt_version")
  sourcePageCount      Int           @default(0) @map("source_page_count")
  sourceCharacterCount Int           @default(0) @map("source_character_count")
  inputTokens          Int?          @map("input_tokens")
  outputTokens         Int?          @map("output_tokens")
  durationMs           Int?          @map("duration_ms")
  activeJobId          String?       @map("active_job_id")
  errorCode            String?       @map("error_code")
  errorMessage         String?       @map("error_message")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("material_summaries")
}

model AiUsage {
  id                   String   @id @default(cuid())
  userId               String   @unique @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyGenerationCount Int      @default(0) @map("daily_generation_count")
  lastResetUtc         DateTime @default(now()) @map("last_reset_utc")
  activeJobsCount      Int      @default(0) @map("active_jobs_count")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("ai_usages")
}

// Milestone 7 — Flashcards and Quizzes
enum FlashcardSetStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum FlashcardMasteryStatus {
  UNRATED
  NEED_REVIEW
  MASTERED
}

model FlashcardSet {
  id          String             @id @default(cuid())
  userId      String             @map("user_id")
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId  String             @map("material_id")
  material    Material           @relation(fields: [materialId], references: [id], onDelete: Cascade)
  title       String
  cardCount   Int                @default(0) @map("card_count")
  status      FlashcardSetStatus @default(QUEUED)
  targetCount Int                @default(10) @map("target_count")
  activeJobId String?            @map("active_job_id")
  errorCode   String?            @map("error_code")
  errorMessage String?           @map("error_message")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  cards Flashcard[]

  @@index([userId, materialId])
  @@index([userId, status])
  @@map("flashcard_sets")
}

model Flashcard {
  id             String                 @id @default(cuid())
  setId          String                 @map("set_id")
  set            FlashcardSet           @relation(fields: [setId], references: [id], onDelete: Cascade)
  front          String                 @db.Text
  back           String                 @db.Text
  pageReferences Int[]                  @map("page_references")
  orderIndex     Int                    @default(0) @map("order_index")
  masteryStatus  FlashcardMasteryStatus @default(UNRATED) @map("mastery_status")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@index([setId, orderIndex])
  @@map("flashcards")
}

enum QuizStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

model Quiz {
  id            String          @id @default(cuid())
  userId        String          @map("user_id")
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId    String          @map("material_id")
  material      Material        @relation(fields: [materialId], references: [id], onDelete: Cascade)
  title         String
  questionCount Int             @default(0) @map("question_count")
  status        QuizStatus      @default(QUEUED)
  targetCount   Int             @default(5) @map("target_count")
  activeJobId   String?         @map("active_job_id")
  errorCode     String?         @map("error_code")
  errorMessage  String?         @map("error_message")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([userId, materialId])
  @@index([userId, status])
  @@map("quizzes")
}

model QuizQuestion {
  id             String   @id @default(cuid())
  quizId         String   @map("quiz_id")
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question       String   @db.Text
  options        String[] // Exactly 4 options
  correctIndex   Int      @map("correct_index") // 0 to 3
  explanation    String   @db.Text
  pageReferences Int[]    @map("page_references")
  orderIndex     Int      @default(0) @map("order_index")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  attemptAnswers QuizAttemptAnswer[]

  @@index([quizId, orderIndex])
  @@map("quiz_questions")
}

model QuizAttempt {
  id                  String    @id @default(cuid())
  quizId              String    @map("quiz_id")
  quiz                Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId              String    @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  score               Float     @default(0) // 0 to 100
  totalQuestions      Int       @default(0) @map("total_questions")
  correctAnswersCount Int       @default(0) @map("correct_answers_count")
  submittedAt         DateTime? @map("submitted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  answers QuizAttemptAnswer[]

  @@index([userId, quizId])
  @@index([userId, submittedAt])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id             String       @id @default(cuid())
  attemptId      String       @map("attempt_id")
  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String       @map("question_id")
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIndex  Int?         @map("selected_index") // 0 to 3, or null if skipped
  isCorrect      Boolean      @default(false) @map("is_correct")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([attemptId, questionId])
  @@map("quiz_attempt_answers")
}

// Milestone: Class Schedules (Jadwal Kuliah Mingguan)
model CourseSchedule {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String   @map("course_id")
  course    Course   @relation(fields: [courseId, userId], references: [id, userId], onDelete: Cascade)
  dayOfWeek Int      @map("day_of_week") // 1 = Senin, 2 = Selasa, 3 = Rabu, 4 = Kamis, 5 = Jumat, 6 = Sabtu, 7 = Minggu
  startTime String   @map("start_time") // Format "HH:mm" (24 jam)
  endTime   String   @map("end_time")   // Format "HH:mm" (24 jam)
  room      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([courseId, dayOfWeek, startTime, endTime])
  @@index([userId, dayOfWeek, startTime])
  @@index([courseId])
  @@map("course_schedules")
}

// Assignment Deadline Reminder H-1 Persistence & Idempotency Logs
enum ReminderLogStatus {
  PENDING
  PROCESSING
  SENT
  SKIPPED
  FAILED
}

model AssignmentReminderLog {
  id           String            @id @default(cuid())
  assignmentId String            @map("assignment_id")
  assignment   Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String            @map("user_id")
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderType String            @default("D_MINUS_1") @map("reminder_type")
  deadline     DateTime          @map("deadline")
  status       ReminderLogStatus @default(PENDING)
  sentAt       DateTime?         @map("sent_at")
  error        String?           @map("error")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@unique([assignmentId, reminderType, deadline], name: "assignment_reminder_unique")
  @@index([userId, status])
  @@index([status, deadline])
  @@map("assignment_reminder_logs")
}

// Pinned/Favorite Items for Materials and Notes
enum PinnedItemType {
  MATERIAL
  NOTE
}

model PinnedItem {
  id         String         @id @default(cuid())
  userId     String         @map("user_id")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       PinnedItemType
  materialId String?        @map("material_id")
  material   Material?      @relation(fields: [materialId], references: [id], onDelete: Cascade)
  noteId     String?        @map("note_id")
  note       Note?          @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now()) @map("created_at")

  @@unique([userId, materialId])
  @@unique([userId, noteId])
  @@index([userId, createdAt])
  @@index([userId, type])
  @@map("pinned_items")
}

enum Role {
  USER
  ADMIN
}
