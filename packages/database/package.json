{
  "name": "@studyflow/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate --schema=./prisma/schema.prisma",
    "build": "tsc",
    "migrate:dev": "prisma migrate dev --schema=./prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "migrate:status": "prisma migrate status --schema=./prisma/schema.prisma",
    "studio": "prisma studio --schema=./prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"Database package linting passed\""
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "^16.4.7",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@studyflow/config": "*",
    "typescript": "^5.8.2"
  }
}
