{
  "openapi": "3.1.0",
  "info": {
    "title": "StudyFlow API",
    "version": "0.2.0",
    "description": "REST API untuk platform StudyFlow — Ruang Belajar Pribadi Mahasiswa. Mencakup endpoint health, readiness, dan autentikasi Milestone 2."
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Development API Server (Express)"
    },
    {
      "url": "http://localhost:3000",
      "description": "BFF Single-Origin Proxy (Next.js)"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Pemeriksaan liveness service API",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "API aktif dan melayani permintaan",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "uptime": { "type": "number" },
                    "service": { "type": "string", "example": "studyflow-api" },
                    "version": { "type": "string", "example": "0.1.0" },
                    "environment": { "type": "string", "example": "development" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Pemeriksaan readiness dependensi (PostgreSQL & Redis)",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Seluruh dependensi database dan cache siap",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "service": { "type": "string", "example": "studyflow-api" },
                    "dependencies": {
                      "type": "object",
                      "properties": {
                        "database": {
                          "type": "object",
                          "properties": {
                            "status": { "type": "string", "enum": ["up", "down"] },
                            "latencyMs": { "type": "number" }
                          }
                        },
                        "redis": {
                          "type": "object",
                          "properties": {
                            "status": { "type": "string", "enum": ["up", "down"] },
                            "latencyMs": { "type": "number" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Satu atau lebih dependensi database/Redis down"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Pendaftaran akun pengguna baru",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string", "minLength": 2, "maxLength": 100 },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 12, "maxLength": 128 },
                  "timezone": { "type": "string", "default": "Asia/Jakarta" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pengguna berhasil dibuat",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "user": { "$ref": "#/components/schemas/UserProfile" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validasi gagal" },
          "409": { "description": "Email sudah terdaftar" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Masuk ke akun (membuat sesi baru)",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login berhasil, cookie HttpOnly disematkan",
            "headers": {
              "Set-Cookie": {
                "schema": { "type": "string" },
                "description": "Mengatur cookie studyflow_access_token dan studyflow_refresh_token"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "user": { "$ref": "#/components/schemas/UserProfile" },
                    "accessToken": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Email atau password tidak sesuai" }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "summary": "Rotasi atomik refresh token dan penerbitan access token baru",
        "tags": ["Authentication"],
        "responses": {
          "200": {
            "description": "Token berhasil dirotasi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "user": { "$ref": "#/components/schemas/UserProfile" },
                    "accessToken": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Token tidak valid, kedaluwarsa, atau terdeteksi replay" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Mencabut sesi aktif di server dan membersihkan cookie browser",
        "tags": ["Authentication"],
        "responses": {
          "200": {
            "description": "Berhasil logout",
            "headers": {
              "Set-Cookie": {
                "schema": { "type": "string" },
                "description": "Menghapus cookie studyflow_access_token dan studyflow_refresh_token"
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Mendapatkan profil pengguna yang sedang login",
        "tags": ["Authentication"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": { "$ref": "#/components/schemas/UserProfile" }
                  }
                }
              }
            }
          },
          "401": { "description": "Tidak terautentikasi" }
        }
      },
      "patch": {
        "summary": "Memperbarui nama dan zona waktu pengguna",
        "tags": ["Authentication"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "minLength": 2, "maxLength": 100 },
                  "timezone": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "user": { "$ref": "#/components/schemas/UserProfile" }
                  }
                }
              }
            }
          },
          "400": { "description": "Data tidak valid" },
          "401": { "description": "Tidak terautentikasi" }
        }
      }
    },
    "/api/auth/change-password": {
      "post": {
        "summary": "Mengganti password akun dan mencabut seluruh sesi lama",
        "tags": ["Authentication"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["currentPassword", "newPassword"],
                "properties": {
                  "currentPassword": { "type": "string" },
                  "newPassword": { "type": "string", "minLength": 12, "maxLength": 128 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password berhasil diganti, seluruh sesi dicabut" },
          "400": { "description": "Password saat ini salah atau password baru tidak memenuhi syarat" },
          "401": { "description": "Tidak terautentikasi" }
        }
      }
    },
    "/api/semesters": {
      "get": {
        "summary": "Mendapatkan daftar semester pengguna",
        "tags": ["Semesters"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["all", "active", "archived"], "default": "all" }
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar semester dan semester aktif",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "semesters": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Semester" }
                    },
                    "activeSemester": {
                      "anyOf": [
                        { "$ref": "#/components/schemas/Semester" },
                        { "type": "null" }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Tidak terautentikasi" }
        }
      },
      "post": {
        "summary": "Membuat semester baru",
        "tags": ["Semesters"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateSemesterInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Semester berhasil dibuat",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "semester": { "$ref": "#/components/schemas/Semester" }
                  }
                }
              }
            }
          },
          "400": { "description": "Input tidak valid" },
          "401": { "description": "Tidak terautentikasi" }
        }
      }
    },
    "/api/semesters/{id}": {
      "get": {
        "summary": "Mendapatkan detail semester",
        "tags": ["Semesters"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Detail semester",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "semester": { "$ref": "#/components/schemas/Semester" }
                  }
                }
              }
            }
          },
          "404": { "description": "Semester tidak ditemukan" }
        }
      },
      "patch": {
        "summary": "Memperbarui nama dan tahun ajaran semester",
        "tags": ["Semesters"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateSemesterInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Semester berhasil diperbarui",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "semester": { "$ref": "#/components/schemas/Semester" }
                  }
                }
              }
            }
          },
          "400": { "description": "Input tidak valid" },
          "404": { "description": "Semester tidak ditemukan" }
        }
      },
      "delete": {
        "summary": "Menghapus semester",
        "tags": ["Semesters"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Semester berhasil dihapus" },
          "409": { "description": "Semester memiliki mata kuliah dan tidak dapat dihapus" },
          "404": { "description": "Semester tidak ditemukan" }
        }
      }
    },
    "/api/semesters/{id}/activate": {
      "post": {
        "summary": "Mengaktifkan semester",
        "tags": ["Semesters"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Semester berhasil diaktifkan" },
          "400": { "description": "Semester terarsip tidak dapat diaktifkan" },
          "404": { "description": "Semester tidak ditemukan" }
        }
      }
    },
    "/api/semesters/{id}/archive": {
      "post": {
        "summary": "Mengarsipkan semester",
        "tags": ["Semesters"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Semester berhasil diarsipkan" },
          "404": { "description": "Semester tidak ditemukan" }
        }
      }
    },
    "/api/semesters/{id}/unarchive": {
      "post": {
        "summary": "Memulihkan semester dari arsip",
        "tags": ["Semesters"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Semester berhasil dipulihkan" },
          "404": { "description": "Semester tidak ditemukan" }
        }
      }
    },
    "/api/courses": {
      "get": {
        "summary": "Mendapatkan daftar mata kuliah",
        "tags": ["Courses"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "semesterId", "in": "query", "schema": { "type": "string" } },
          { "name": "isArchived", "in": "query", "schema": { "type": "boolean" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Daftar mata kuliah",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "courses": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Course" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Membuat mata kuliah baru",
        "tags": ["Courses"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateCourseInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mata kuliah berhasil ditambahkan",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "course": { "$ref": "#/components/schemas/Course" }
                  }
                }
              }
            }
          },
          "400": { "description": "Semester diarsipkan atau input tidak valid" },
          "404": { "description": "Semester tidak ditemukan" }
        }
      }
    },
    "/api/courses/{id}": {
      "get": {
        "summary": "Mendapatkan detail mata kuliah",
        "tags": ["Courses"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Detail mata kuliah",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "course": { "$ref": "#/components/schemas/Course" }
                  }
                }
              }
            }
          },
          "404": { "description": "Mata kuliah tidak ditemukan" }
        }
      },
      "patch": {
        "summary": "Memperbarui detail mata kuliah",
        "tags": ["Courses"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateCourseInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mata kuliah berhasil diperbarui",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "course": { "$ref": "#/components/schemas/Course" }
                  }
                }
              }
            }
          },
          "404": { "description": "Mata kuliah tidak ditemukan" }
        }
      },
      "delete": {
        "summary": "Menghapus mata kuliah",
        "tags": ["Courses"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Mata kuliah berhasil dihapus" },
          "404": { "description": "Mata kuliah tidak ditemukan" }
        }
      }
    },
    "/api/courses/{id}/archive": {
      "post": {
        "summary": "Mengarsipkan mata kuliah",
        "tags": ["Courses"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Mata kuliah berhasil diarsipkan" },
          "404": { "description": "Mata kuliah tidak ditemukan" }
        }
      }
    },
    "/api/courses/{id}/unarchive": {
      "post": {
        "summary": "Memulihkan mata kuliah dari arsip",
        "tags": ["Courses"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Mata kuliah berhasil dipulihkan" },
          "404": { "description": "Mata kuliah tidak ditemukan" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "timezone": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Semester": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "name": { "type": "string" },
          "academicYear": { "type": "string" },
          "isActive": { "type": "boolean" },
          "archivedAt": { "type": "string", "format": "date-time", "nullable": true },
          "courseCount": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateSemesterInput": {
        "type": "object",
        "required": ["name", "academicYear"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 100 },
          "academicYear": { "type": "string", "minLength": 4, "maxLength": 20 },
          "makeActive": { "type": "boolean" }
        }
      },
      "UpdateSemesterInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 100 },
          "academicYear": { "type": "string", "minLength": 4, "maxLength": 20 }
        }
      },
      "Course": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "semesterId": { "type": "string" },
          "name": { "type": "string" },
          "code": { "type": "string", "nullable": true },
          "lecturer": { "type": "string", "nullable": true },
          "description": { "type": "string", "nullable": true },
          "archivedAt": { "type": "string", "format": "date-time", "nullable": true },
          "semester": { "$ref": "#/components/schemas/Semester" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateCourseInput": {
        "type": "object",
        "required": ["semesterId", "name"],
        "properties": {
          "semesterId": { "type": "string" },
          "name": { "type": "string", "minLength": 2, "maxLength": 150 },
          "code": { "type": "string", "maxLength": 30 },
          "lecturer": { "type": "string", "maxLength": 100 },
          "description": { "type": "string", "maxLength": 1000 }
        }
      },
      "UpdateCourseInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 150 },
          "code": { "type": "string", "maxLength": 30 },
          "lecturer": { "type": "string", "maxLength": 100 },
          "description": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "studyflow_access_token"
      }
    }
  }
}
