# StudyFlow Admin Environment Configuration
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# DO NOT place backend secrets or database credentials in this file.

# URL of the backend API for browser requests and server-side BFF proxy
NEXT_PUBLIC_API_URL="http://localhost:3001"
INTERNAL_API_URL="http://localhost:3001"

# Application Environment
NODE_ENV=development
PORT=3002

# Ingress / Reverse Proxy Client IP Identification (BFF Proxy)
# TRUSTED_CLIENT_IP_HEADER=""
