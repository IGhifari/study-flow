# Worker Process Environment Configuration
NODE_ENV=development

# Redis Connection for BullMQ
REDIS_URL="redis://localhost:6379"

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://studyflow_user:studyflow_dev_password@localhost:5433/studyflow_dev?schema=public"

# Storage Driver Configuration (M5)
# Options: 'local' (disk storage shared with API in dev), 'supabase' (remote private bucket), 'memory' (in-memory mock for tests), 'none' (disabled)
STORAGE_DRIVER=local

# Supabase Storage Configuration (wajib diisi jika STORAGE_DRIVER=supabase)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"
SUPABASE_STORAGE_BUCKET="studyflow-materials"

# Local Storage Directory (opsional, default: <workspace_root>/.storage/materials)
# LOCAL_STORAGE_DIR=".storage/materials"

# AI Provider Configuration (M6 — Free Tier Only)
# Options: 'gemini' | 'mock' | 'none'
AI_PROVIDER=gemini
GEMINI_API_KEY="your-google-ai-studio-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# Provider Rate Limiting & Call Bounding (M6)
# Batas panggilan per menit yang disesuaikan dengan kuota proyek (RPM)
AI_CALLS_PER_MINUTE=15
# Batas total akumulasi panggilan provider per pekerjaan (termasuk chunk & retry)
AI_MAX_CALLS_PER_JOB=8

# Email & SMTP Configuration for Deadline Reminders
APP_PUBLIC_URL="http://localhost:3000"
EMAIL_DRIVER=mock
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_FROM="StudyFlow <no-reply@studyflow.local>"
