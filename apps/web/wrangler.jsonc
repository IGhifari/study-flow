{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studyflow-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "INTERNAL_API_URL": "https://big-toward-handy-producers.trycloudflare.com",
    "NEXT_PUBLIC_API_URL": "https://big-toward-handy-producers.trycloudflare.com"
  }
}
