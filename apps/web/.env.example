# Web Frontend Environment Configuration
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# DO NOT place backend secrets or database credentials in this file.

# URL of the backend API for browser requests
NEXT_PUBLIC_API_URL="http://localhost:4000"
INTERNAL_API_URL="http://localhost:4000"

# Application Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Ingress / Reverse Proxy Client IP Identification (BFF Proxy)
# ------------------------------------------------------------------------------
# Opsi:
#   - Kosong / tidak diset / 'none' (DEFAULT & AMAN):
#     Mode tanpa ingress terpercaya. Header IP yang dikirim oleh pengguna
#     (seperti X-Forwarded-For, X-Real-IP, CF-Connecting-IP, Forwarded) TIDAK DIPERCAYA
#     demi mencegah spoofing/bypass rate limit.
#     Semua request melalui BFF diteruskan ke API backend sebagai 127.0.0.1
#     (semua pengguna web berbagi satu bucket IP rate limit Express).
#     Perlindungan brute-force akun tetap aktif dan aman via loginAccountRateLimiter.
#   - 'x-real-ip' | 'cf-connecting-ip' | header tunggal lainnya:
#     Mode reverse proxy terpercaya. HANYA gunakan jika reverse proxy ingress
#     (Nginx, Cloudflare, AWS ALB, dsb.) terbukti SELALU menimpa header tersebut
#     dengan IP TCP koneksi nyata, serta akses langsung dari internet ke port
#     origin BFF DIBATASI KETAT (firewall / private network).
# TRUSTED_CLIENT_IP_HEADER=""

