# API Server Environment Configuration
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://studyflow_user:studyflow_dev_password@localhost:5433/studyflow_dev?schema=public"

# Redis Connection (BullMQ and Caching)
REDIS_URL="redis://localhost:6379"

# CORS configuration for Web Frontend
CORS_ORIGIN="http://localhost:3000"

# Storage Driver Configuration (M5)
# Options: 'local' (disk storage shared with worker in dev), 'supabase' (remote private bucket), 'memory' (in-memory mock for tests), 'none' (disabled/503)
STORAGE_DRIVER=local

# Supabase Storage Configuration (wajib diisi jika STORAGE_DRIVER=supabase)
# Bucket HARUS privat: 'studyflow-materials'
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"
SUPABASE_STORAGE_BUCKET="studyflow-materials"
STORAGE_SIGNED_URL_EXPIRES_IN=300

# Local Storage Directory (opsional, default: <workspace_root>/.storage/materials)
# LOCAL_STORAGE_DIR=".storage/materials"
API_BASE_URL="http://localhost:4000"

# AI Provider Configuration (M6 — Free Tier Only)
# Options: 'gemini' | 'mock' | 'none'
AI_PROVIDER=gemini
GEMINI_API_KEY="your-google-ai-studio-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash-lite"
