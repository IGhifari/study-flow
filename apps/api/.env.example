# API Server Environment Configuration
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://studyflow_user:studyflow_dev_password@localhost:5433/studyflow_dev?schema=public"

# Redis Connection (BullMQ and Caching)
REDIS_URL="redis://localhost:6379"

# CORS configuration for Web Frontend and Admin Portal
CORS_ORIGIN="http://localhost:3000,http://localhost:3002,http://localhost:3005"

# Autentikasi JWT & Sesi (Wajib diubah dari nilai default pada lingkungan produksi)
JWT_ACCESS_SECRET="studyflow_dev_jwt_access_secret_super_secure_key_12345"
JWT_REFRESH_SECRET="studyflow_dev_jwt_refresh_secret_super_secure_key_12345"
COOKIE_SECRET="studyflow_dev_cookie_signing_secret_super_secure_key_12345"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# ------------------------------------------------------------------------------
# Proxy & Rate Limiting Configuration
# ------------------------------------------------------------------------------
# TRUST_PROXY: Mengatur opsi 'trust proxy' pada Express.
# Default: 'loopback' (HANYA mempercayai 127.0.0.1 / ::1, yaitu instance BFF lokal).
# JANGAN menggunakan 'true' atau subnet privat luas secara sembarangan, karena dapat
# membuka celah pemalsuan header X-Forwarded-For oleh klien luar.
# Opsi: 'loopback' | 'false' | '10.0.1.5' (IP/CIDR spesifik BFF).
TRUST_PROXY="loopback"

# RATE_LIMIT_STORE: Shared counter store untuk express-rate-limit.
# Opsi: 'redis' (default dev/prod, atomik via Lua script) | 'memory' (fallback test).
RATE_LIMIT_STORE="redis"


# Storage Driver Configuration (M5)
# Options: 'local' (disk storage shared with worker in dev), 'supabase' (remote private bucket), 'memory' (in-memory mock for tests), 'none' (disabled/503)
STORAGE_DRIVER=local

# Supabase Storage Configuration (wajib diisi jika STORAGE_DRIVER=supabase)
# Bucket HARUS privat: 'studyflow-materials'
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"
SUPABASE_STORAGE_BUCKET="studyflow-materials"
STORAGE_SIGNED_URL_EXPIRES_IN=300

# Local Storage Directory (opsional, default: <workspace_root>/.storage/materials)
# LOCAL_STORAGE_DIR=".storage/materials"
API_BASE_URL="http://localhost:4000"

# AI Provider Configuration (M6 — Free Tier Only)
# Options: 'gemini' | 'mock' | 'none'
AI_PROVIDER=gemini
GEMINI_API_KEY="your-google-ai-studio-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# Google OAuth 2.0 (Authorization Code Flow with PKCE & Nonce)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Email / SMTP Configuration (Password Reset)
# Driver options: 'smtp' | 'mock'
APP_PUBLIC_URL="http://localhost:3000"
EMAIL_DRIVER=mock
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_FROM="StudyFlow <no-reply@studyflow.app>"

# Cloudflare Turnstile CAPTCHA Protection
# Secret key server-side (JANGAN diekspos ke browser / frontend)
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"



